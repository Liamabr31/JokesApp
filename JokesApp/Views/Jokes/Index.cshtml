@model IEnumerable<JokesApp.Models.Joke>

@{
    ViewData["Title"] = "Jokes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Jokes</h1>
    <div>
        <a class="btn btn-primary" asp-action="Create">Create New Joke</a>
        <a class="btn btn-secondary" asp-action="ShowSearchForm">Search</a>
    </div>
</div>

@if (!Model.Any())
{
    <p>No jokes were found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Question</th>
                <th>Answer</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.JokeQuestion</td>
                <td>@item.JokeAnswer</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
