@model JokesApp.Models.Joke

@{
    ViewData["Title"] = "Delete Joke";
}

<h1>Delete Joke</h1>

<h3>Are you sure you want to delete this joke?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Question</dt>
        <dd class="col-sm-10">@Model.JokeQuestion</dd>

        <dt class="col-sm-2">Answer</dt>
        <dd class="col-sm-10">@Model.JokeAnswer</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
